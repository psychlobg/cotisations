# Règles inbound pour DNS et LDAP
Get-NetFirewallRule -Direction Inbound -Enabled True | 
  Where-Object { $_.DisplayName -match "DNS|LDAP|Domain Controller|Active Directory" } |
  Get-NetFirewallAddressFilter | 
  Select-Object -Property @{n='Rule';e={(Get-NetFirewallRule -AssociatedNetFirewallAddressFilter $_).DisplayName}}, 
                          RemoteAddress, LocalAddress | 
  Format-Table -AutoSize

Get-NetFirewallRule -Direction Inbound -Enabled True | 
  Where-Object { $_.DisplayName -match "DNS|LDAP|Domain Controller" } | 
  Format-Table DisplayName, Profile, 
    @{n='RemoteAddress';e={(Get-NetFirewallAddressFilter -AssociatedNetFirewallRule $_).RemoteAddress}} -AutoSize

