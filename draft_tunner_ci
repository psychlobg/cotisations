	---
- name: Mise à jour des GitLab Runners + Certificat CA
  hosts: gitlab_runners
  become: yes
  vars:
    ca_cert_src: "/chemin/local/sur/ton/ansible/ta-ca-racine.crt"  # ← à adapter
    ca_cert_dest: "/etc/gitlab-runner/certs/ca-racine.crt"
    runner_user: "gitlab-runner"

  tasks:

    - name: Créer le dossier pour les certificats
      ansible.builtin.file:
        path: /etc/gitlab-runner/certs
        state: directory
        owner: "{{ runner_user }}"
        group: "{{ runner_user }}"
        mode: '0755'

    - name: Déployer le certificat CA sur le runner
      ansible.builtin.copy:
        src: "{{ ca_cert_src }}"
        dest: "{{ ca_cert_dest }}"
        owner: "{{ runner_user }}"
        group: "{{ runner_user }}"
        mode: '0644'

    - name: Configurer le volume dans config.toml (Docker executor)
      ansible.builtin.blockinfile:
        path: /etc/gitlab-runner/config.toml
        marker: "# {mark} ANSIBLE MANAGED - CA Certificate"
        block: |
          [[runners]]
            [runners.docker]
              volumes = [
                "/cache",
                "{{ ca_cert_dest }}:{{ ca_cert_dest }}:ro"
              ]
      when: "'docker' in runner_executor"  # variable à définir si besoin

    - name: Redémarrer le GitLab Runner
      ansible.builtin.systemd:
        name: gitlab-runner
        state: restarted
        daemon_reload: yes

    - name: Vérification du certificat sur le runner
      ansible.builtin.command: ls -l {{ ca_cert_dest }}
      changed_when: false
      register: cert_check

    - name: Afficher le statut
      ansible.builtin.debug:
        msg: "Certificat déployé → {{ cert_check.stdout }}"
		
		
