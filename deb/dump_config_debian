# 1. Vérification de l'existence de la clé SSH
if (-not (Test-Path $SshKey)) {
    Write-Error "La clé SSH est introuvable à l'emplacement : $SshKey"
    exit 1
}

# 2. Saisie sécurisée du mot de passe sudo pour la session
$SudoPass = Read-Host "Entrez le mot de passe sudo pour les serveurs distants" -AsSecureString
$BSTR = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($SudoPass)
$PlainSudoPass = [System.Runtime.InteropServices.Marshal]::PtrToStringAuto($BSTR)

$Timestamp = Get-Date -Format "yyyyMMdd_HHmmss"

# Fonction helper pour exécuter sudo à distance
function Invoke-SudoSsh {
    param (
        [string]$Target,
        [string]$RemoteCommand
    )
    # Transmet le mot de passe sudo via stdin (sudo -S)
    $PlainSudoPass | ssh -i $SshKey -q -n $Target "sudo -S -p '' $RemoteCommand 2>/dev/null"
}

foreach ($Target in $Servers) {
    $CleanHost = $Target -replace '[^a-zA-Z0-9._-]', '_'
    $DestDir = ".\dumps\${CleanHost}_${Timestamp}"

    $null = New-Item -ItemType Directory -Force -Path "$DestDir\services_config"
    $null = New-Item -ItemType Directory -Force -Path "$DestDir\scripts_recuperes"

    Write-Host "=== Collecte sur $Target -> $DestDir ===" -ForegroundColor Green

    # 1. Arborescence et droits
    Write-Host "[1/5] Listing des dossiers et droits..." -ForegroundColor Cyan
    $FolderOutput = foreach ($Dir in $DirsToInspect) {
        "`n=== Structure et droits pour $Dir ==="
        Invoke-SudoSsh -Target $Target -RemoteCommand "ls -laR '$Dir'"
    }
    $FolderOutput | Out-File -FilePath "$DestDir\dossiers_et_droits.txt" -Encoding utf8

    # 2. Services
    Write-Host "[2/5] Extraction des services..." -ForegroundColor Cyan
    Invoke-SudoSsh -Target $Target -RemoteCommand "systemctl list-unit-files --type=service" | Out-File "$DestDir\services_config\systemd_services.txt" -Encoding utf8
    Invoke-SudoSsh -Target $Target -RemoteCommand "systemctl status nginx" | Out-File "$DestDir\services_config\nginx_status.txt" -Encoding utf8
    Invoke-SudoSsh -Target $Target -RemoteCommand "nginx -T" | Out-File "$DestDir\services_config\nginx_full_conf.txt" -Encoding utf8

    # 3. Versions des binaires
    Write-Host "[3/5] Vérification des versions des binaires..." -ForegroundColor Cyan
    $BinOutput = foreach ($Bin in $BinariesToCheck) {
        $Res = ssh -i $SshKey -n $Target "command -v '$Bin' >/dev/null 2>&1 && '$Bin' --version 2>&1 || echo 'Non installé'"
        "$Bin: $Res"
    }
    $BinOutput | Out-File -FilePath "$DestDir\versions_binaires.txt" -Encoding utf8

    # 4. Config TC
    Write-Host "[4/5] Extraction de la config TC pour ens0..." -ForegroundColor Cyan
    $TcOutput = @(
        Invoke-SudoSsh -Target $Target -RemoteCommand "tc qdisc show dev ens0"
        Invoke-SudoSsh -Target $Target -RemoteCommand "tc class show dev ens0"
        Invoke-SudoSsh -Target $Target -RemoteCommand "tc filter show dev ens0"
    )
    $TcOutput | Out-File -FilePath "$DestDir\tc_ens0_config.txt" -Encoding utf8

    # 5. Configuration sshd_config
    Write-Host "[5/5] Récupération de sshd_config..." -ForegroundColor Cyan
    Invoke-SudoSsh -Target $Target -RemoteCommand "cat /etc/ssh/sshd_config" | Out-File "$DestDir\sshd_config" -Encoding utf8

    # 6. Copie des scripts distants
    Write-Host "[Bonus] Rapatriement des scripts distants..." -ForegroundColor Cyan
    foreach ($ScriptPath in $FilesToFetch) {
        $FileName = Split-Path $ScriptPath -Leaf
        Invoke-SudoSsh -Target $Target -RemoteCommand "cat '$ScriptPath'" | Out-File "$DestDir\scripts_recuperes\$FileName" -Encoding utf8
    }

    Write-Host "Collecte terminée pour $Target !`n" -ForegroundColor Green
}

Write-Host "Toutes les extractions sont terminées dans .\dumps\" -ForegroundColor Yellow

# 6. Copie des scripts distants en conservant l'arborescence
    Write-Host "[Bonus] Rapatriement des scripts distants (arborescence conservée)..." -ForegroundColor Cyan
    foreach ($ScriptPath in $FilesToFetch) {
        # Nettoie le chemin pour en faire un chemin relatif Windows (remplace / par \)
        $RelPath = $ScriptPath.TrimStart('/').Replace('/', '\')
        $LocalFilePath = Join-Path "$DestDir\scripts_recuperes" $RelPath
        $LocalDirPath  = Split-Path $LocalFilePath -Parent

        # Crée l'arborescence de dossiers en local
        if (-not (Test-Path $LocalDirPath)) {
            $null = New-Item -ItemType Directory -Force -Path $LocalDirPath
        }

        # Récupère le contenu et l'écrit dans le fichier local
        Invoke-SudoSsh -Target $Target -RemoteCommand "cat '$ScriptPath'" | Out-File -FilePath $LocalFilePath -Encoding utf8
    }
$FileSuffixed = "myscript_$(Get-Date -Format 'yyyy-MM-dd_HHmm').py"

