#!/usr/bin/env bash

set -euo pipefail

# ------------------------------------------------------------------------------
# CONFIGURATION
# ------------------------------------------------------------------------------
# Chemin vers ta clé privée SSH sur ton poste local
SSH_KEY="$HOME/.ssh/id_ed25519"

# Liste des serveurs SSH (format: utilisateur@ip_ou_nom)
SERVERS=(
    "admin@192.168.1.10"
    "admin@192.168.1.11"
)

DIRS_TO_INSPECT=("/etc" "/var/www")
BINARIES_TO_CHECK=("nginx" "docker" "python3" "curl")
FILES_TO_FETCH=("/usr/local/bin/backup.sh" "/root/deploy.sh")

# ------------------------------------------------------------------------------
# EXÉCUTION
# ------------------------------------------------------------------------------
# Vérification de l'existence de la clé privée
if [ ! -f "${SSH_KEY}" ]; then
    echo "Erreur : La clé SSH '${SSH_KEY}' est introuvable."
    exit 1
fi

# Demande du mot de passe sudo pour les exécutions distantes
read -sp "[?] Entrez le mot de passe sudo pour les serveurs distants : " SUDO_PASS
echo -e "\n"

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")

for TARGET in "${SERVERS[@]}"; do
    HOSTNAME_CLEAN=$(echo "${TARGET}" | sed 's/[^a-zA-Z0-9._-]/_/g')
    DEST_DIR="./dumps/${HOSTNAME_CLEAN}_${TIMESTAMP}"

    mkdir -p "${DEST_DIR}/services_config" "${DEST_DIR}/scripts_recuperes"
    echo "=== Collecte sur ${TARGET} -> ${DEST_DIR} ==="

    # Fonction pour exécuter sudo à distance avec la clé SSH
    run_sudo() {
        echo "${SUDO_PASS}" | ssh -i "${SSH_KEY}" -q -n "${TARGET}" "sudo -S -p '' $1 2>/dev/null" || true
    }

    # 1. Arborescence et droits
    echo "[1/5] Listing des dossiers et droits..."
    {
        for dir in "${DIRS_TO_INSPECT[@]}"; do
            echo -e "\n=== Structure et droits pour ${dir} ==="
            run_sudo "ls -laR '${dir}'"
        done
    } > "${DEST_DIR}/dossiers_et_droits.txt"

    # 2. Services
    echo "[2/5] Extraction des services..."
    run_sudo "systemctl list-unit-files --type=service" > "${DEST_DIR}/services_config/systemd_services.txt"
    run_sudo "systemctl status nginx" > "${DEST_DIR}/services_config/nginx_status.txt"
    run_sudo "nginx -T" > "${DEST_DIR}/services_config/nginx_full_conf.txt"

    # 3. Versions des binaires
    echo "[3/5] Vérification des versions des binaires..."
    {
        for bin in "${BINARIES_TO_CHECK[@]}"; do
            echo -n "${bin}: "
            ssh -i "${SSH_KEY}" -n "${TARGET}" "command -v '${bin}' >/dev/null 2>&1 && '${bin}' --version 2>&1 || echo 'Non installé'"
        done
    } > "${DEST_DIR}/versions_binaires.txt"

    # 4. Config TC
    echo "[4/5] Extraction de la config TC pour ens0..."
    {
        run_sudo "tc qdisc show dev ens0"
        run_sudo "tc class show dev ens0"
        run_sudo "tc filter show dev ens0"
    } > "${DEST_DIR}/tc_ens0_config.txt"

    # 5. Configuration sshd_config
    echo "[5/5] Récupération de sshd_config..."
    run_sudo "cat /etc/ssh/sshd_config" > "${DEST_DIR}/sshd_config"

    # 6. Copie des scripts distants
    echo "[Bonus] Rapatriement des scripts distants..."
    for script_path in "${FILES_TO_FETCH[@]}"; do
        filename=$(basename "${script_path}")
        run_sudo "cat '${script_path}'" > "${DEST_DIR}/scripts_recuperes/${filename}"
    done

    echo "Collecte terminée pour ${TARGET} !"
    echo "----------------------------------------------"
done

# 6. Copie des scripts distants en conservant l'arborescence
    echo "[Bonus] Rapatriement des scripts distants (arborescence conservée)..."
    for script_path in "${FILES_TO_FETCH[@]}"; do
        # Retire le premier slash pour créer un chemin relatif
        rel_path="${script_path#/}"
        # Détermine le dossier de destination local
        target_dir="${DEST_DIR}/scripts_recuperes/$(dirname "${rel_path}")"
        
        # Crée les dossiers locaux nécessaires
        mkdir -p "${target_dir}"
        
        # Récupère le contenu du fichier via sudo cat
        run_sudo "cat '${script_path}'" > "${DEST_DIR}/scripts_recuperes/${rel_path}"
    done
file_suffixed="myscript_$(date +'%Y-%m-%d_%H%M').py"

      
