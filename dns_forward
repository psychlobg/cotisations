# ==================== CONFIGURATION ====================
$ConditionalForwarders = @{
    "zone1.dom.intra"   = @("IP_DU_SERVEUR_ZONE1_1", "IP_DU_SERVEUR_ZONE1_2")   # Remplace par les vraies IPs
    "zone2.dom.intra"   = @("IP_DU_SERVEUR_ZONE2")                              # Exemple pour une seule IP
    # Ajoute ici les autres zones
    # "zone3.dom.intra" = @("10.20.30.40", "10.20.30.41")
}

$ReplicationScope = "Domain"   # "Domain" ou "Forest"
# =======================================================

foreach ($zone in $ConditionalForwarders.Keys) {
    # Vérifier si le conditional forwarder existe déjà
    if (Get-DnsServerConditionalForwarderZone -Name $zone -ErrorAction SilentlyContinue) {
        Write-Host "Mise à jour du Conditional Forwarder pour $zone" -ForegroundColor Yellow
        Set-DnsServerConditionalForwarderZone `
            -Name $zone `
            -MasterServers $ConditionalForwarders[$zone] `
            -PassThru
    }
    else {
        Write-Host "Création du Conditional Forwarder pour $zone" -ForegroundColor Green
        Add-DnsServerConditionalForwarderZone `
            -Name $zone `
            -MasterServers $ConditionalForwarders[$zone] `
            -ReplicationScope $ReplicationScope `
            -PassThru
    }
}

Write-Host "`nConfiguration terminée !" -ForegroundColor Cyan


# Voir tous les conditional forwarders
Get-DnsServerConditionalForwarderZone | Select Name, MasterServers, ReplicationScope

# Tester la résolution
