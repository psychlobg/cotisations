debug-ca-cert:
  stage: build
  script:
    # 1. Vérifier que le fichier est bien monté
    - echo "=== Fichier monté ==="
    - ls -l /etc/gitlab-runner/certs/ca-racine.crt || echo "Fichier non trouvé !"

    # 2. Vérifier que le système le reconnaît (Debian/Ubuntu)
    - echo "=== Trust store Ubuntu/Debian ==="
    - cat /etc/ssl/certs/ca-certificates.crt | grep -A 5 "BEGIN CERTIFICATE" | tail -10 || echo "Pas de CA dans le trust store"

    # 3. Mise à jour + vérification (à adapter selon ton OS)
    - echo "=== Mise à jour du trust store ==="
    - apt-get update -qq && apt-get install -y ca-certificates
    - cp /etc/gitlab-runner/certs/ca-racine.crt /usr/local/share/ca-certificates/
    - update-ca-certificates --fresh
    - update-ca-certificates -v | grep "added"

    # 4. Vérifier avec openssl (très fiable)
    - echo "=== Test OpenSSL ==="
    - echo | openssl s_client -connect registry.fqdn:443 -CAfile /etc/gitlab-runner/certs/ca-racine.crt 2>&1 | grep -E "Verify return code|subject|issuer"

    # 5. Test Podman
    - echo "=== Test Podman ==="
    - podman info | grep -E "registry|search"
