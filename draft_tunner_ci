- name: Mise à jour du GitLab Runner
  hosts: gitlab_runners
  become: yes
  vars:
    runner_version: "latest"   # ou une version précise ex: "17.0.0"

  tasks:

    - name: Arrêter le service GitLab Runner
      ansible.builtin.systemd:
        name: gitlab-runner
        state: stopped

    - name: Télécharger la dernière version du Runner
      ansible.builtin.get_url:
        url: "https://gitlab.com/gitlab-org/gitlab-runner/-/releases/{{ runner_version }}/downloads/gitlab-runner-linux-amd64"
        dest: /usr/local/bin/gitlab-runner
        mode: '0755'
        owner: root
        group: root
      when: runner_version == "latest"

    - name: Vérifier la version installée
      ansible.builtin.command: /usr/local/bin/gitlab-runner --version
      register: runner_version_check
      changed_when: false

    - name: Redémarrer le service
      ansible.builtin.systemd:
        name: gitlab-runner
        state: restarted
        daemon_reload: yes
        enabled: yes

    - name: Afficher la version après mise à jour
      ansible.builtin.debug:
        msg: "GitLab Runner mis à jour → {{ runner_version_check.stdout }}"
		
